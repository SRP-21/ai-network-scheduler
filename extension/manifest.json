{
  "manifest_version": 3,
  "name": "AI Network Scheduler",
  "version": "2.0",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
